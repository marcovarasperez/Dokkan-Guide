{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dokkan Fan Guide",
  "version": "0.4.1",
  "identifier": "fan.dokkanguide.global",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dokkan Fan Guide — Global",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Entertainment",
    "shortDescription": "Guía fan de Dokkan Battle Global",
    "publisher": "Dokkan Fan Guide (proyecto fan no comercial)",
    "copyright": "Proyecto fan no comercial · Datos: DOKKAN.FYI"
  }
}
